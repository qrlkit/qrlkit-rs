{
  "web": {
    "docs": "https://docs.rs/ratatui/latest/ratatui/"
  },
  "paths": {
    "repo": "./",
    "project": "/home/bob/work/project",
    "readme": "./README.md"
  },
  "scripts": {
    "greet": {
      "$run": "printf 'Hello, %s!\\n' \"$1\"\nprintf 'From %s\\n' \"$PWD\"\n",
      "$shell": "bash"
    },
    "greet-windows": {
      "$run": "Write-Output \"Hello, $($args[0])!\"\nWrite-Output \"From $PWD\"\n",
      "$shell": "pwsh"
    }
  }
}
